<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_feribot"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FeriBot">

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.mapa.MapaActivity"
            android:exported="false"
            android:label="@string/mapa_titulo" />

        <activity
            android:name=".ui.foto.FotoActivity"
            android:exported="false"
            android:label="@string/foto_titulo"
            android:screenOrientation="portrait" />

    </application>

</manifest>
