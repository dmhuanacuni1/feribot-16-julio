<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/textoMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_burbuja_bot"
        android:lineSpacingExtra="2dp"
        android:maxWidth="300dp"
        android:padding="12dp"
        android:textColor="@color/texto_principal"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonMapa"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:minHeight="36dp"
            android:text="@string/chat_ver_mapa"
            android:textColor="@color/azul"
            android:visibility="gone"
            app:icon="@drawable/ic_mapa"
            app:iconTint="@color/azul" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonFoto"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="@string/chat_foto"
            android:textColor="@color/azul"
            android:visibility="gone"
            app:icon="@drawable/ic_camara"
            app:iconTint="@color/azul" />

    </LinearLayout>

</LinearLayout>
