<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/vistaPrevia"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarFoto"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_gravity="top"
        android:background="#66000000"
        app:navigationIcon="@drawable/ic_cerrar"
        app:navigationIconTint="@color/blanco"
        app:subtitle="@string/foto_subtitulo"
        app:subtitleTextColor="#D6E4FF"
        app:title="@string/foto_titulo"
        app:titleTextColor="@color/blanco" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#8C000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCancelar"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/foto_cancelar"
            android:textColor="@color/blanco" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCapturar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:backgroundTint="@color/ambar"
            android:enabled="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/foto_capturar"
            android:textColor="@color/texto_principal"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_camara"
            app:iconTint="@color/texto_principal" />

    </LinearLayout>

</FrameLayout>
